{
  "manifest_version": 3,
  "name": "ShareL",
  "version": "0.1.0",
  "description": "Upload images, videos, audio and text, or shorten links, with ShareL (ShareX for GNOME).",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sharel@hawkins.app",
      "strict_min_version": "115.0"
    }
  }
}
